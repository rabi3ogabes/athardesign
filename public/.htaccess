# أثر لتصميم الويب — Apache configuration (document root = public/)
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS when behind a plain Apache (comment out if the host terminates TLS elsewhere)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block access to dotfiles
    RewriteRule (^|/)\.(?!well-known) - [F]

    # Serve existing files directly (assets, uploads)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else goes to the front controller
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Never execute scripts inside uploads
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php|phtml|phar|pl|py|cgi|sh)$ - [F]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(woff2|css|js|svg|png|jpg|jpeg|webp|gif|avif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/avif .avif
AddDefaultCharset UTF-8
