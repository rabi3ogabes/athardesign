# ---------------------------------------------------------------
#  أثر لتصميم الويب — environment configuration
#  Copy this file to .env and fill in the values, or simply open
#  https://your-domain/install and let the installer write it.
# ---------------------------------------------------------------

# production | local
APP_ENV=production
APP_DEBUG=false

# Public URL of the website (no trailing slash). Leave empty to auto-detect.
APP_URL=

# Timezone used for dates in the dashboard
APP_TIMEZONE=Asia/Qatar

# MySQL / MariaDB (cPanel: MySQL Databases → create a database and a user with ALL PRIVILEGES)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
# Optional: unix socket instead of host/port
# DB_SOCKET=

# Random 32+ character string used to sign cookies, cron URLs and tokens
APP_SECRET=

# Cache lifetime (seconds) for public content. The admin panel clears it on every save.
CACHE_TTL=600

# Optional: path of the admin panel (default /admin)
ADMIN_PATH=/admin
